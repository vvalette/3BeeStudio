# ⚠️ NE JAMAIS COMMITER CE FICHIER — ajouter .env.local au .gitignore
# Copier ce fichier en .env.local et remplir les vraies valeurs

# ─── Stripe ───────────────────────────────────────────────────
# Checkout par redirection (page hébergée Stripe) → pas de clé publishable nécessaire.
# Mode test : sk_test_... / Mode live : sk_live_...
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Resend (emails) ──────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# En dev : utiliser onboarding@resend.dev (envoi uniquement vers l'email du compte Resend)
# En prod : mettre commandes@3beestudio.fr après vérification du domaine dans le dashboard Resend
RESEND_FROM_EMAIL=onboarding@resend.dev
# Destinataire des notifications internes : nouvelle commande (NFC, boutique,
# sur-mesure) et messages du formulaire de contact.
# Optionnel — défaut : contact@3beestudio.fr
# Plusieurs adresses possibles, séparées par des virgules.
# ADMIN_EMAIL=contact@3beestudio.fr,perso@exemple.fr

# Destinataire des alertes critiques (échecs webhook Stripe, surventes de stock).
# Optionnel — défaut : ADMIN_EMAIL, sinon contact@3beestudio.fr
# ALERT_EMAIL=contact@3beestudio.fr

# ─── Upstash Redis (rate limiting distribué) ──────────────────
# Optionnel — sans ces clés, le rate limiting retombe sur la mémoire (par instance).
# À activer avant toute campagne de pub payante : console.upstash.com (plan gratuit)
# ou Vercel Marketplace → Upstash Redis.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXXXXX

# ─── Boxtal (expédition) ──────────────────────────────────────
BOXTAL_API_URL=https://api.boxtal.build
# En prod : BOXTAL_API_URL=https://api.boxtal.com + clés prod ci-dessous
BOXTAL_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
BOXTAL_SECRET_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── Offres d'expédition (codes CARRIER-Service) ──────────────
# ⚠ L'API Boxtal v3 n'expose AUCUN endpoint de devis : le prix n'est connu
# qu'APRÈS création de l'expédition (deliveryPriceExclTax). Impossible donc de
# comparer les tarifs à la volée — le choix se fait par ordre de préférence.
#
# Catalogue complet des codes : boxtal/shipping-offer-codes.md
#
# DOMICILE — liste ordonnée de la MOINS chère à la plus chère. La première offre
# que le compte accepte est retenue, avec repli automatique si une offre est
# refusée (NoShippingOfferException : rien n'est créé, le repli est donc sûr).
# Défaut : MONR-DomicileFrance puis POFR-ColissimoAccess.
# BOXTAL_HOME_OFFER_CODES=MONR-DomicileFrance,POFR-ColissimoAccess
#
# RELAIS — une seule offre, PAS de repli : le pickupPointCode enregistré sur la
# commande appartient au réseau interrogé par le sélecteur. Changer ce code
# change le sélecteur ET l'expédition, de façon cohérente.
# Alternatives : CHRP-ChronoShoptoShop (Shop2Shop), SOGP-RelaisColis.
# BOXTAL_RELAY_OFFER_CODE=MONR-CpourToi

BOXTAL_SENDER_FIRSTNAME=Prénom
BOXTAL_SENDER_LASTNAME=Nom
BOXTAL_SENDER_EMAIL=contact@3beestudio.fr
BOXTAL_SENDER_PHONE=+33XXXXXXXXX
BOXTAL_SENDER_COMPANY=3BeeStudio
BOXTAL_SENDER_STREET=Adresse
BOXTAL_SENDER_CITY=Ville
BOXTAL_SENDER_POSTAL_CODE=XXXXX
BOXTAL_SENDER_COUNTRY=FR

# ─── Boxtal (webhook) ─────────────────────────────────────────
# Clé de validation de la souscription webhook Boxtal (POST /v3.1/subscription)
# Utilisée pour vérifier le header x-bxt-signature (HMAC SHA256)
# Générer avec : openssl rand -hex 32
BOXTAL_WEBHOOK_SECRET=changeme

# ─── Admin ────────────────────────────────────────────────────
ADMIN_PASSWORD=changeme

# ─── App ──────────────────────────────────────────────────────
# En dev : http://localhost:3001 / En prod : https://3beestudio.fr
NEXT_PUBLIC_APP_URL=http://localhost:3001
